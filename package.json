{
  "name": "daymark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/smoke.mjs",
    "test:extension": "node scripts/extension-smoke.mjs",
    "format": "prettier --write \"src/Daymark/Web/*.{js,mjs,html,css}\" \"extension/*.{js,mjs,html,css,json}\" \"tests/*.mjs\" \"scripts/*.mjs\""
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "prettier": "^3.6.2"
  }
}
